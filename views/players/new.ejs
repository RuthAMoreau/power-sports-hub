<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Add Player | Power Sports Hub</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand" href="/">Power Sports Hub</a>

    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/dashboard">Dashboard</a>
      <a class="nav-link" href="/teams">Teams</a>
      <a class="nav-link" href="/players">Players</a>
      <a class="nav-link" href="/logout">Logout</a>
    </div>
  </div>
</nav>

<main class="container py-5">

  <div class="card shadow-sm mx-auto" style="max-width: 700px;">
    <div class="card-body p-4">

      <h1 class="h2">Add Player</h1>

      <p class="text-muted">
        Add a player to an existing team.
      </p>

      <% if (error) { %>
        <div class="alert alert-danger">
          <%= error %>
        </div>
      <% } %>

      <% if (teams.length === 0) { %>

        <div class="alert alert-warning">
          You must create a team before adding a player.
        </div>

        <a href="/teams/new" class="btn btn-primary">
          Create Team
        </a>

      <% } else { %>

        <form action="/players" method="POST">

          <div class="row">

            <div class="col-md-6 mb-3">
              <label for="firstName" class="form-label">
                First Name
              </label>

              <input
                type="text"
                class="form-control"
                id="firstName"
                name="firstName"
                value="<%= formData.firstName || '' %>"
                maxlength="50"
                required
              >
            </div>

            <div class="col-md-6 mb-3">
              <label for="lastName" class="form-label">
                Last Name
              </label>

              <input
                type="text"
                class="form-control"
                id="lastName"
                name="lastName"
                value="<%= formData.lastName || '' %>"
                maxlength="50"
                required
              >
            </div>

          </div>

          <div class="row">

            <div class="col-md-6 mb-3">
              <label for="jerseyNumber" class="form-label">
                Jersey Number
              </label>

              <input
                type="number"
                class="form-control"
                id="jerseyNumber"
                name="jerseyNumber"
                value="<%= formData.jerseyNumber || '' %>"
                min="0"
                max="99"
              >
            </div>

            <div class="col-md-6 mb-3">
              <label for="position" class="form-label">
                Position
              </label>

              <input
                type="text"
                class="form-control"
                id="position"
                name="position"
                value="<%= formData.position || '' %>"
                placeholder="Example: Pitcher"
                maxlength="50"
              >
            </div>

          </div>

          <div class="mb-3">
            <label for="team" class="form-label">
              Team
            </label>

            <select
              class="form-select"
              id="team"
              name="team"
              required
            >
              <option value="">Select a team</option>

              <% teams.forEach(team => { %>

                <option
                  value="<%= team._id %>"
                  <%= selectedTeamId.toString() === team._id.toString()
                    ? "selected"
                    : "" %>
                >
                  <%= team.teamName %> —
                  <%= team.ageGroup %>
                </option>

              <% }) %>

            </select>
          </div>

          <div class="mb-3">
            <label for="parentName" class="form-label">
              Parent or Guardian Name
            </label>

            <input
              type="text"
              class="form-control"
              id="parentName"
              name="parentName"
              value="<%= formData.parentName || '' %>"
              maxlength="100"
            >
          </div>

          <div class="mb-4">
            <label for="parentEmail" class="form-label">
              Parent or Guardian Email
            </label>

            <input
              type="email"
              class="form-control"
              id="parentEmail"
              name="parentEmail"
              value="<%= formData.parentEmail || '' %>"
            >
          </div>

          <button type="submit" class="btn btn-primary">
            Add Player
          </button>

          <a href="/players" class="btn btn-outline-secondary">
            Cancel
          </a>

        </form>

      <% } %>

    </div>
  </div>

</main>

</body>
</html>
