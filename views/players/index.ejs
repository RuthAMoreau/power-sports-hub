<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Players | Power Sports Hub</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">

    <a class="navbar-brand" href="/">
      Power Sports Hub
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div
      class="collapse navbar-collapse"
      id="navbarNav"
    >

      <div class="navbar-nav ms-auto">

        <a class="nav-link" href="/dashboard">
          Dashboard
        </a>

        <a class="nav-link" href="/teams">
          Teams
        </a>

        <a
          class="nav-link active"
          href="/players"
          aria-current="page"
        >
          Players
        </a>

        <a class="nav-link" href="/events">
          Schedule
        </a>

        <a class="nav-link" href="/announcements">
          Announcements
        </a>

        <a class="nav-link" href="/logout">
          Logout
        </a>

      </div>

    </div>

  </div>
</nav>

<main class="container py-5">

  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"
  >

    <div>

      <h1 class="mb-1">
        Players
      </h1>

      <p class="text-muted mb-0">
        View players across the organization.
      </p>

    </div>

    <% if (
      user &&
      (
        user.role === "admin" ||
        user.role === "coach"
      )
    ) { %>

      <a
        href="/players/new"
        class="btn btn-primary"
      >
        Add Player
      </a>

    <% } %>

  </div>

  <!-- Search form -->

  <form
    action="/players"
    method="GET"
    class="row g-2 mb-4"
  >

    <div class="col-12 col-md">

      <label
        for="search"
        class="visually-hidden"
      >
        Search players
      </label>

      <input
        type="search"
        id="search"
        name="search"
        class="form-control"
        placeholder="Search players..."
        value="<%= search || '' %>"
      >

    </div>

    <div class="col-auto">

      <button
        class="btn btn-primary"
        type="submit"
      >
        Search
      </button>

    </div>

    <div class="col-auto">

      <a
        href="/players"
        class="btn btn-outline-secondary"
      >
        Clear
      </a>

    </div>

  </form>

  <% if (!players || players.length === 0) { %>

    <div class="alert alert-info">

      <% if (search) { %>

        No players matched
        "<strong><%= search %></strong>."

        <a
          href="/players"
          class="alert-link"
        >
          Clear the search.
        </a>

      <% } else { %>

        No players have been added yet.

        <% if (
          user &&
          (
            user.role === "admin" ||
            user.role === "coach"
          )
        ) { %>

          <a
            href="/players/new"
            class="alert-link"
          >
            Add the first player.
          </a>

        <% } %>

      <% } %>

    </div>

  <% } else { %>

    <% if (search) { %>

      <p class="text-muted mb-2">
        Showing results for
        "<strong><%= search %></strong>".
      </p>

    <% } %>

    <p class="text-muted">
      <%= totalPlayers %>
      player<%= totalPlayers === 1 ? "" : "s" %>
      found.
    </p>

    <div class="table-responsive">

      <table class="table table-striped table-hover align-middle">

        <thead>

          <tr>
            <th scope="col">Player</th>
            <th scope="col">Number</th>
            <th scope="col">Position</th>
            <th scope="col">Team</th>
            <th scope="col">Parent</th>

            <% if (
              user &&
              (
                user.role === "admin" ||
                user.role === "coach"
              )
            ) { %>

              <th scope="col">
                Actions
              </th>

            <% } %>

          </tr>

        </thead>

        <tbody>

          <% players.forEach(player => { %>

            <tr>

              <td>
                <%= player.firstName %>
                <%= player.lastName %>
              </td>

              <td>
                <%= player.jerseyNumber ?? "—" %>
              </td>

              <td>
                <%= player.position || "—" %>
              </td>

              <td>

                <% if (player.team) { %>

                  <a href="/teams/<%= player.team._id %>">
                    <%= player.team.teamName %>
                    (<%= player.team.ageGroup %>)
                  </a>

                <% } else { %>

                  No team

                <% } %>

              </td>

              <td>
                <%= player.parentName || "—" %>
              </td>

              <% if (
                user &&
                (
                  user.role === "admin" ||
                  user.role === "coach"
                )
              ) { %>

                <td>

                  <div class="d-flex flex-wrap gap-2">

                    <a
                      href="/players/<%= player._id %>/edit"
                      class="btn btn-sm btn-outline-primary"
                    >
                      Edit
                    </a>

                    <% if (user.role === "admin") { %>

                      <form
                        action="/players/<%= player._id %>?_method=DELETE"
                        method="POST"
                        onsubmit="return confirm('Delete this player?');"
                      >

                        <button
                          type="submit"
                          class="btn btn-sm btn-outline-danger"
                        >
                          Delete
                        </button>

                      </form>

                    <% } %>

                  </div>

                </td>

              <% } %>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

    <% if (totalPages > 1) { %>

      <nav
        class="mt-4"
        aria-label="Player page navigation"
      >

        <ul class="pagination justify-content-center flex-wrap">

          <li
            class="page-item <%= page === 1 ? 'disabled' : '' %>"
          >

            <a
              class="page-link"
              href="/players?page=<%= page - 1 %>&search=<%= encodeURIComponent(search || '') %>"
              aria-label="Previous page"
              <%= page === 1
                ? 'tabindex="-1" aria-disabled="true"'
                : ""
              %>
            >
              Previous
            </a>

          </li>

          <% for (
            let pageNumber = 1;
            pageNumber <= totalPages;
            pageNumber++
          ) { %>

            <li
              class="page-item <%= pageNumber === page ? 'active' : '' %>"
            >

              <a
                class="page-link"
                href="/players?page=<%= pageNumber %>&search=<%= encodeURIComponent(search || '') %>"
                <%= pageNumber === page
                  ? 'aria-current="page"'
                  : ""
                %>
              >
                <%= pageNumber %>
              </a>

            </li>

          <% } %>

          <li
            class="page-item <%= page === totalPages ? 'disabled' : '' %>"
          >

            <a
              class="page-link"
              href="/players?page=<%= page + 1 %>&search=<%= encodeURIComponent(search || '') %>"
              aria-label="Next page"
              <%= page === totalPages
                ? 'tabindex="-1" aria-disabled="true"'
                : ""
              %>
            >
              Next
            </a>

          </li>

        </ul>

      </nav>

    <% } %>

  <% } %>

</main>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
></script>

</body>
</html>
