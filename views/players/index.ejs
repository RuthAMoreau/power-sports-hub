<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Players | Power Sports Hub</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand" href="/">Power Sports Hub</a>

    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/dashboard">Dashboard</a>
      <a class="nav-link" href="/teams">Teams</a>
      <a class="nav-link active" href="/players">Players</a>
      <a class="nav-link" href="/logout">Logout</a>
    </div>
  </div>
</nav>

<main class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1>Players</h1>
      <p class="text-muted mb-0">
        View players across the organization.
      </p>
    </div>

    <a href="/players/new" class="btn btn-primary">
      Add Player
    </a>
  </div>

  <% if (players.length === 0) { %>

    <div class="alert alert-info">
      No players have been added yet.
    </div>

  <% } else { %>

    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">

        <thead>
          <tr>
            <th>Player</th>
            <th>Number</th>
            <th>Position</th>
            <th>Team</th>
            <th>Parent</th>
          </tr>
        </thead>

        <tbody>

          <% players.forEach(player => { %>

            <tr>
              <td>
                <%= player.firstName %>
                <%= player.lastName %>
              </td>

              <td>
                <%= player.jerseyNumber ?? "—" %>
              </td>

              <td>
                <%= player.position || "—" %>
              </td>

              <td>
                <% if (player.team) { %>
                  <a href="/teams/<%= player.team._id %>">
                    <%= player.team.teamName %>
                    (<%= player.team.ageGroup %>)
                  </a>
                <% } else { %>
                  No team
                <% } %>
              </td>

              <td>
                <%= player.parentName || "—" %>
              </td>
            </tr>

          <% }) %>

        </tbody>

      </table>
    </div>

  <% } %>

</main>

</body>
</html>
