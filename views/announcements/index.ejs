<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Announcements | Power Sports Hub
  </title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>

<nav
  class="navbar navbar-expand-lg navbar-dark bg-primary"
>
  <div class="container">

    <a class="navbar-brand" href="/">
      Power Sports Hub
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div
      class="collapse navbar-collapse"
      id="mainNavbar"
    >
      <ul class="navbar-nav ms-auto">

        <li class="nav-item">
          <a
            class="nav-link"
            href="/dashboard"
          >
            Dashboard
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/teams"
          >
            Teams
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/players"
          >
            Players
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/events"
          >
            Schedule
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link active"
            href="/announcements"
            aria-current="page"
          >
            Announcements
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/logout"
          >
            Logout
          </a>
        </li>

      </ul>
    </div>

  </div>
</nav>

<main class="container py-5">

  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"
  >
    <div>

      <h1 class="mb-1">
        Announcements
      </h1>

      <p class="text-muted mb-0">
        View updates for the sports organization.
      </p>

    </div>

    <% if (
      user &&
      (
        user.role === "admin" ||
        user.role === "coach"
      )
    ) { %>

      <a
        href="/announcements/new"
        class="btn btn-primary"
      >
        Add Announcement
      </a>

    <% } %>

  </div>

  <!-- Search, audience filter, and sorting -->

  <form
    action="/announcements"
    method="GET"
    class="row g-2 mb-4"
  >

    <div class="col-12 col-lg-4">

      <label
        for="search"
        class="visually-hidden"
      >
        Search announcements
      </label>

      <input
        type="search"
        id="search"
        name="search"
        class="form-control"
        placeholder="Search title or message"
        value="<%= search || "" %>"
      >

    </div>

    <div class="col-12 col-md-6 col-lg-3">

      <label
        for="audience"
        class="visually-hidden"
      >
        Filter by audience
      </label>

      <select
        id="audience"
        name="audience"
        class="form-select"
      >

        <option value="">
          All Audiences
        </option>

        <option
          value="Everyone"
          <%= audience === "Everyone" ? "selected" : "" %>
        >
          Everyone
        </option>

        <option
          value="Players"
          <%= audience === "Players" ? "selected" : "" %>
        >
          Players
        </option>

        <option
          value="Parents"
          <%= audience === "Parents" ? "selected" : "" %>
        >
          Parents
        </option>

        <option
          value="Coaches"
          <%= audience === "Coaches" ? "selected" : "" %>
        >
          Coaches
        </option>

      </select>

    </div>

    <div class="col-12 col-md-6 col-lg-3">

      <label
        for="sort"
        class="visually-hidden"
      >
        Sort announcements
      </label>

      <select
        id="sort"
        name="sort"
        class="form-select"
      >

        <option
          value="newest"
          <%= sort === "newest" ? "selected" : "" %>
        >
          Newest First
        </option>

        <option
          value="oldest"
          <%= sort === "oldest" ? "selected" : "" %>
        >
          Oldest First
        </option>

        <option
          value="title-asc"
          <%= sort === "title-asc" ? "selected" : "" %>
        >
          Title A–Z
        </option>

        <option
          value="title-desc"
          <%= sort === "title-desc" ? "selected" : "" %>
        >
          Title Z–A
        </option>

      </select>

    </div>

    <div class="col-auto">

      <button
        type="submit"
        class="btn btn-primary"
      >
        Apply
      </button>

    </div>

    <div class="col-auto">

      <a
        href="/announcements"
        class="btn btn-outline-secondary"
      >
        Clear
      </a>

    </div>

  </form>

  <% if (
    !announcements ||
    announcements.length === 0
  ) { %>

    <div class="alert alert-info">

      <% if (search && audience) { %>

        No announcements matched
        <strong>"<%= search %>"</strong>
        for
        <strong><%= audience %></strong>.

        <a
          href="/announcements"
          class="alert-link"
        >
          Clear the search and filters.
        </a>

      <% } else if (search) { %>

        No announcements matched
        <strong>"<%= search %>"</strong>.

        <a
          href="/announcements"
          class="alert-link"
        >
          Clear the search.
        </a>

      <% } else if (audience) { %>

        No announcements were found for
        <strong><%= audience %></strong>.

        <a
          href="/announcements"
          class="alert-link"
        >
          Clear the filter.
        </a>

      <% } else { %>

        No announcements have been posted yet.

        <% if (
          user &&
          (
            user.role === "admin" ||
            user.role === "coach"
          )
        ) { %>

          <a
            href="/announcements/new"
            class="alert-link"
          >
            Create the first announcement.
          </a>

        <% } %>

      <% } %>

    </div>

  <% } else { %>

    <% if (search || audience) { %>

      <p class="text-muted mb-2">

        <% if (search && audience) { %>

          Showing results for
          <strong>"<%= search %>"</strong>
          in
          <strong><%= audience %></strong> announcements.

        <% } else if (search) { %>

          Showing results for
          <strong>"<%= search %>"</strong>.

        <% } else if (audience) { %>

          Showing announcements for
          <strong><%= audience %></strong>.

        <% } %>

      </p>

    <% } %>

    <p class="text-muted mb-3">
      <%= totalAnnouncements %>
      announcement<%= totalAnnouncements === 1 ? "" : "s" %>
      found.
    </p>

    <div class="row g-4">

      <% announcements.forEach(announcement => { %>

        <div class="col-12 col-lg-6">

          <article class="card h-100 shadow-sm">

            <div class="card-body d-flex flex-column">

              <div
                class="d-flex justify-content-between align-items-start gap-3 mb-2"
              >

                <h2 class="h4 card-title mb-0">
                  <%= announcement.title %>
                </h2>

                <span class="badge text-bg-primary">
                  <%= announcement.audience %>
                </span>

              </div>

              <p class="card-text">
                <%= announcement.message %>
              </p>

              <hr>

              <p class="small text-muted mb-1">

                <strong>Posted:</strong>

                <% if (announcement.createdAt) { %>

                  <%= new Date(
                    announcement.createdAt
                  ).toLocaleDateString() %>

                <% } else { %>

                  Date unavailable

                <% } %>

              </p>

              <p class="small text-muted mb-0">

                <strong>Author:</strong>

                <% if (announcement.author) { %>

                  <% if (
                    announcement.author.firstName ||
                    announcement.author.lastName
                  ) { %>

                    <%= announcement.author.firstName || "" %>
                    <%= announcement.author.lastName || "" %>

                  <% } else { %>

                    <%= announcement.author.name || "User" %>

                  <% } %>

                <% } else { %>

                  Unknown

                <% } %>

              </p>

              <% if (
                user &&
                (
                  user.role === "admin" ||
                  user.role === "coach"
                )
              ) { %>

                <div class="d-flex flex-wrap gap-2 mt-auto pt-3">

                  <a
                    href="/announcements/<%= announcement._id %>/edit"
                    class="btn btn-sm btn-outline-primary"
                  >
                    Edit
                  </a>

                  <% if (user.role === "admin") { %>

                    <form
                      action="/announcements/<%= announcement._id %>?_method=DELETE"
                      method="POST"
                      onsubmit="return confirm('Delete this announcement?');"
                    >

                      <button
                        type="submit"
                        class="btn btn-sm btn-outline-danger"
                      >
                        Delete
                      </button>

                    </form>

                  <% } %>

                </div>

              <% } %>

            </div>

          </article>

        </div>

      <% }) %>

    </div>

    <% if (totalPages > 1) { %>

      <nav
        class="mt-4"
        aria-label="Announcement page navigation"
      >

        <ul class="pagination justify-content-center flex-wrap">

          <li
            class="page-item <%= page === 1 ? "disabled" : "" %>"
          >

            <a
              class="page-link"
              href="/announcements?page=<%= page - 1 %>&search=<%= encodeURIComponent(search || '') %>&audience=<%= encodeURIComponent(audience || '') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
              aria-label="Previous page"
              <%= page === 1 ? 'tabindex="-1" aria-disabled="true"' : "" %>
            >
              Previous
            </a>

          </li>

          <% for (
            let pageNumber = 1;
            pageNumber <= totalPages;
            pageNumber++
          ) { %>

            <li
              class="page-item <%= pageNumber === page ? "active" : "" %>"
            >

              <a
                class="page-link"
                href="/announcements?page=<%= pageNumber %>&search=<%= encodeURIComponent(search || '') %>&audience=<%= encodeURIComponent(audience || '') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
                <%= pageNumber === page
                  ? 'aria-current="page"'
                  : ""
                %>
              >
                <%= pageNumber %>
              </a>

            </li>

          <% } %>

          <li
            class="page-item <%= page === totalPages ? "disabled" : "" %>"
          >

            <a
              class="page-link"
              href="/announcements?page=<%= page + 1 %>&search=<%= encodeURIComponent(search || '') %>&audience=<%= encodeURIComponent(audience || '') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
              aria-label="Next page"
              <%= page === totalPages
                ? 'tabindex="-1" aria-disabled="true"'
                : ""
              %>
            >
              Next
            </a>

          </li>

        </ul>

      </nav>

    <% } %>

  <% } %>

</main>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
></script>

</body>
</html>
