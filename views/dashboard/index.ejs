<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Power Sports Hub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
        <a class="navbar-brand" href="/">🏆 Power Sports Hub</a>

        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/teams">Teams</a>
            <a class="nav-link" href="/logout">Logout</a>
        </div>
    </div>
</nav>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Welcome, <%= user.name %>!</h1>
            <p class="text-muted">
                Manage your youth sports organization from one place.
            </p>
        </div>

        <a href="/logout" class="btn btn-danger">
            Logout
        </a>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>🥎 Teams</h3>
                    <p>Create and manage your teams.</p>

                    <a href="/teams" class="btn btn-primary">
                        View Teams
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>👥 Players</h3>
                    <p>Player profiles and rosters.</p>

                    <button class="btn btn-secondary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>📅 Schedule</h3>
                    <p>Practices and game schedules.</p>

                    <button class="btn btn-secondary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>📢 Announcements</h3>
                    <p>Post updates for families.</p>

                    <button class="btn btn-secondary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>📊 Reports</h3>
                    <p>Organization statistics.</p>

                    <a href="/events" class="btn btn-primary">
                      View Schedule
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>⚙️ Admin</h3>
                    <p>User and organization management.</p>

                    <button class="btn btn-secondary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
