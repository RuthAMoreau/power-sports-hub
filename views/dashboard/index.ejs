<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Dashboard | Power Sports Hub
  </title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">

    <a class="navbar-brand" href="/">
      Power Sports Hub
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div
      class="collapse navbar-collapse"
      id="mainNavbar"
    >
      <ul class="navbar-nav ms-auto">

        <li class="nav-item">
          <a
            class="nav-link active"
            href="/dashboard"
          >
            Dashboard
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/teams"
          >
            Teams
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/players"
          >
            Players
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/events"
          >
            Schedule
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/announcements"
          >
            Announcements
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/logout"
          >
            Logout
          </a>
        </li>

      </ul>
    </div>

  </div>
</nav>

<main class="container py-5">

  <div class="mb-4">

    <h1 class="mb-1">
      Dashboard
    </h1>

    <p class="text-muted mb-0">
      Welcome back<% if (
        user &&
        user.firstName
      ) { %>, <%= user.firstName %><% } %>.
    </p>

  </div>

  <!-- Summary cards -->
  <div class="row g-4 mb-5">

    <div class="col-12 col-sm-6 col-lg-3">

      <div class="card h-100 shadow-sm">

        <div class="card-body">

          <h2 class="h5">
            Teams
          </h2>

          <p class="display-6 fw-bold text-primary mb-3">
            <%= teamCount %>
          </p>

          <a
            href="/teams"
            class="btn btn-outline-primary"
          >
            View Teams
          </a>

        </div>

      </div>

    </div>

    <div class="col-12 col-sm-6 col-lg-3">

      <div class="card h-100 shadow-sm">

        <div class="card-body">

          <h2 class="h5">
            Players
          </h2>

          <p class="display-6 fw-bold text-primary mb-3">
            <%= playerCount %>
          </p>

          <a
            href="/players"
            class="btn btn-outline-primary"
          >
            View Players
          </a>

        </div>

      </div>

    </div>

    <div class="col-12 col-sm-6 col-lg-3">

      <div class="card h-100 shadow-sm">

        <div class="card-body">

          <h2 class="h5">
            Upcoming Events
          </h2>

          <p class="display-6 fw-bold text-primary mb-3">
            <%= eventCount %>
          </p>

          <a
            href="/events"
            class="btn btn-outline-primary"
          >
            View Schedule
          </a>

        </div>

      </div>

    </div>

    <div class="col-12 col-sm-6 col-lg-3">

      <div class="card h-100 shadow-sm">

        <div class="card-body">

          <h2 class="h5">
            Announcements
          </h2>

          <p class="display-6 fw-bold text-primary mb-3">
            <%= announcementCount %>
          </p>

          <a
            href="/announcements"
            class="btn btn-outline-primary"
          >
            View Announcements
          </a>

        </div>

      </div>

    </div>

  </div>

  <div class="row g-4">

    <!-- Upcoming events -->
    <div class="col-12 col-lg-7">

      <div class="card h-100 shadow-sm">

        <div
          class="card-header bg-white d-flex justify-content-between align-items-center"
        >
          <h2 class="h4 mb-0">
            Upcoming Events
          </h2>

          <a
            href="/events/new"
            class="btn btn-sm btn-primary"
          >
            Add Event
          </a>
        </div>

        <div class="card-body">

          <% if (
            !upcomingEvents ||
            upcomingEvents.length === 0
          ) { %>

            <div class="alert alert-info mb-0">
              There are no upcoming events.
            </div>

          <% } else { %>

            <div class="list-group list-group-flush">

              <% upcomingEvents.forEach(event => { %>

                <a
                  href="/events/<%= event._id %>/edit"
                  class="list-group-item list-group-item-action px-0"
                >

                  <div
                    class="d-flex justify-content-between align-items-start gap-3"
                  >

                    <div>

                      <h3 class="h6 mb-1">
                        <%= event.title %>
                      </h3>

                      <p class="small text-muted mb-1">

                        <% if (event.team) { %>

                          <%= event.team.teamName %>

                          <% if (event.team.ageGroup) { %>
                            — <%= event.team.ageGroup %>
                          <% } %>

                        <% } else { %>
                          Team unavailable
                        <% } %>

                      </p>

                      <% if (event.location) { %>

                        <p class="small text-muted mb-0">
                          <%= event.location %>
                        </p>

                      <% } %>

                    </div>

                    <div class="text-end">

                      <span class="badge text-bg-primary mb-1">
                        <%= event.eventType %>
                      </span>

                      <p class="small mb-0">
                        <%= new Date(
                          event.date
                        ).toLocaleDateString() %>
                      </p>

                      <p class="small text-muted mb-0">
                        <%= new Date(
                          event.date
                        ).toLocaleTimeString([], {
                          hour: "numeric",
                          minute: "2-digit"
                        }) %>
                      </p>

                    </div>

                  </div>

                </a>

              <% }) %>

            </div>

          <% } %>

        </div>

        <div class="card-footer bg-white">

          <a href="/events">
            View full schedule
          </a>

        </div>

      </div>

    </div>

    <!-- Recent announcements -->
    <div class="col-12 col-lg-5">

      <div class="card h-100 shadow-sm">

        <div
          class="card-header bg-white d-flex justify-content-between align-items-center"
        >

          <h2 class="h4 mb-0">
            Recent Announcements
          </h2>

          <a
            href="/announcements/new"
            class="btn btn-sm btn-primary"
          >
            Add
          </a>

        </div>

        <div class="card-body">

          <% if (
            !recentAnnouncements ||
            recentAnnouncements.length === 0
          ) { %>

            <div class="alert alert-info mb-0">
              No announcements have been posted.
            </div>

          <% } else { %>

            <div class="list-group list-group-flush">

              <% recentAnnouncements.forEach(
                announcement => {
              ) { %>

                <a
                  href="/announcements/<%= announcement._id %>/edit"
                  class="list-group-item list-group-item-action px-0"
                >

                  <div
                    class="d-flex justify-content-between align-items-start gap-2"
                  >

                    <div>

                      <h3 class="h6 mb-1">
                        <%= announcement.title %>
                      </h3>

                      <p class="small text-muted mb-1">
                        <%= announcement.message.length > 100
                          ? announcement.message.substring(
                              0,
                              100
                            ) + "..."
                          : announcement.message
                        %>
                      </p>

                      <p class="small text-muted mb-0">

                        <% if (announcement.createdAt) { %>

                          <%= new Date(
                            announcement.createdAt
                          ).toLocaleDateString() %>

                        <% } else { %>
                          Date unavailable
                        <% } %>

                      </p>

                    </div>

                    <span class="badge text-bg-secondary">
                      <%= announcement.audience %>
                    </span>

                  </div>

                </a>

              <% }) %>

            </div>

          <% } %>

        </div>

        <div class="card-footer bg-white">

          <a href="/announcements">
            View all announcements
          </a>

        </div>

      </div>

    </div>

  </div>

</main>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
></script>

</body>
</html>
