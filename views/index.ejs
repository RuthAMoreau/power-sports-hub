<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Dashboard | Power Sports Hub
  </title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/css/style.css"
  >
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">

    <a class="navbar-brand" href="/dashboard">
      🏆 Power Sports Hub
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div
      class="collapse navbar-collapse"
      id="mainNavbar"
    >
      <ul class="navbar-nav ms-auto">

        <li class="nav-item">
          <a
            class="nav-link active"
            href="/dashboard"
            aria-current="page"
          >
            Dashboard
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/teams"
          >
            Teams
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/players"
          >
            Players
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/events"
          >
            Schedule
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/announcements"
          >
            Announcements
          </a>
        </li>

        <li class="nav-item">
          <a
            class="nav-link"
            href="/logout"
          >
            Logout
          </a>
        </li>

      </ul>
    </div>

  </div>
</nav>

<main class="container py-5">

  <div class="mb-4">

    <h1 class="mb-1">
      Dashboard
    </h1>

    <p class="text-muted mb-0">

      Welcome back<% if (user && user.firstName) { %>,
        <strong><%= user.firstName %></strong>
      <% } %>.

      Manage your sports organization from one place.

    </p>

  </div>

  <!-- Dashboard Statistics -->

  <section class="row g-4 mb-5">

    <div class="col-12 col-sm-6 col-xl-3">

      <div class="card h-100 shadow-sm">
        <div class="card-body">

          <p class="text-muted mb-2">
            Teams
          </p>

          <h2 class="display-6 fw-bold mb-3">
            <%= teamCount %>
          </h2>

          <a
            href="/teams"
            class="btn btn-sm btn-outline-primary"
          >
            View Teams
          </a>

        </div>
      </div>

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

      <div class="card h-100 shadow-sm">
        <div class="card-body">

          <p class="text-muted mb-2">
            Players
          </p>

          <h2 class="display-6 fw-bold mb-3">
            <%= playerCount %>
          </h2>

          <a
            href="/players"
            class="btn btn-sm btn-outline-primary"
          >
            View Players
          </a>

        </div>
      </div>

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

      <div class="card h-100 shadow-sm">
        <div class="card-body">

          <p class="text-muted mb-2">
            Upcoming Events
          </p>

          <h2 class="display-6 fw-bold mb-3">
            <%= eventCount %>
          </h2>

          <a
            href="/events"
            class="btn btn-sm btn-outline-primary"
          >
            View Schedule
          </a>

        </div>
      </div>

    </div>

    <div class="col-12 col-sm-6 col-xl-3">

      <div class="card h-100 shadow-sm">
        <div class="card-body">

          <p class="text-muted mb-2">
            Announcements
          </p>

          <h2 class="display-6 fw-bold mb-3">
            <%= announcementCount %>
          </h2>

          <a
            href="/announcements"
            class="btn btn-sm btn-outline-primary"
          >
            View Announcements
          </a>

        </div>
      </div>

    </div>

  </section>

  <div class="row g-4">

    <!-- Upcoming Events -->

    <section class="col-12 col-lg-6">

      <div class="card h-100 shadow-sm">

        <div
          class="card-header bg-white d-flex justify-content-between align-items-center"
        >

          <h2 class="h4 mb-0">
            Upcoming Events
          </h2>

          <a
            href="/events"
            class="btn btn-sm btn-outline-primary"
          >
            View All
          </a>

        </div>

        <div class="card-body">

          <% if (
            !upcomingEvents ||
            upcomingEvents.length === 0
          ) { %>

            <div class="alert alert-info mb-0">
              No upcoming events are scheduled.
            </div>

          <% } else { %>

            <div class="list-group list-group-flush">

              <% upcomingEvents.forEach(event => { %>

                <div class="list-group-item px-0">

                  <div
                    class="d-flex justify-content-between align-items-start gap-3"
                  >

                    <div>

                      <h3 class="h6 mb-1">
                        <%= event.title || event.eventName || "Event" %>
                      </h3>

                      <% if (event.team) { %>

                        <p class="small text-muted mb-1">

                          <%= event.team.teamName || "Team" %>

                          <% if (event.team.ageGroup) { %>
                            · <%= event.team.ageGroup %>
                          <% } %>

                        </p>

                      <% } %>

                      <% if (event.location) { %>

                        <p class="small text-muted mb-0">
                          <strong>Location:</strong>
                          <%= event.location %>
                        </p>

                      <% } %>

                    </div>

                    <span class="badge text-bg-primary">

                      <% if (event.date) { %>

                        <%= new Date(
                          event.date
                        ).toLocaleDateString() %>

                      <% } else { %>

                        Date unavailable

                      <% } %>

                    </span>

                  </div>

                </div>

              <% }) %>

            </div>

          <% } %>

        </div>

      </div>

    </section>

    <!-- Recent Announcements -->

    <section class="col-12 col-lg-6">

      <div class="card h-100 shadow-sm">

        <div
          class="card-header bg-white d-flex justify-content-between align-items-center"
        >

          <h2 class="h4 mb-0">
            Recent Announcements
          </h2>

          <a
            href="/announcements"
            class="btn btn-sm btn-outline-primary"
          >
            View All
          </a>

        </div>

        <div class="card-body">

          <% if (
            !recentAnnouncements ||
            recentAnnouncements.length === 0
          ) { %>

            <div class="alert alert-info mb-0">
              No announcements have been posted.
            </div>

          <% } else { %>

            <div class="list-group list-group-flush">

              <% recentAnnouncements.forEach(announcement => { %>

                <div class="list-group-item px-0">

                  <div
                    class="d-flex justify-content-between align-items-start gap-3 mb-1"
                  >

                    <h3 class="h6 mb-0">
                      <%= announcement.title %>
                    </h3>

                    <span class="badge text-bg-primary">
                      <%= announcement.audience %>
                    </span>

                  </div>

                  <p class="small mb-2">
                    <%= announcement.message %>
                  </p>

                  <p class="small text-muted mb-0">

                    <% if (announcement.createdAt) { %>

                      Posted
                      <%= new Date(
                        announcement.createdAt
                      ).toLocaleDateString() %>

                    <% } %>

                    <% if (announcement.author) { %>

                      by
                      <%= announcement.author.firstName || "" %>
                      <%= announcement.author.lastName || "" %>

                    <% } %>

                  </p>

                </div>

              <% }) %>

            </div>

          <% } %>

        </div>

      </div>

    </section>

  </div>

</main>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
></script>

</body>
</html>
