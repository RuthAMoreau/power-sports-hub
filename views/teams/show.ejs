<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= team.teamName %> | Power Sports Hub</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">
    <a class="navbar-brand" href="/">Power Sports Hub</a>

    <div class="navbar-nav ms-auto">
      <a class="nav-link" href="/dashboard">Dashboard</a>
      <a class="nav-link" href="/teams">Teams</a>
      <a class="nav-link" href="/players">Players</a>
      <a class="nav-link" href="/logout">Logout</a>
    </div>
  </div>
</nav>

<main class="container py-5">

  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">

    <div>
      <h1><%= team.teamName %></h1>

      <p class="text-muted mb-1">
        <strong>Age Group:</strong>
        <%= team.ageGroup %>
      </p>

      <p class="text-muted mb-1">
        <strong>Season:</strong>
        <%= team.season %>
      </p>

      <p class="text-muted">
        <strong>Coach:</strong>

        <% if (team.coach) { %>
          <%= team.coach.firstName %>
          <%= team.coach.lastName %>
        <% } else { %>
          Not assigned
        <% } %>
      </p>
    </div>

    <div>
      <a
        href="/players/new?team=<%= team._id %>"
        class="btn btn-primary"
      >
        Add Player
      </a>
    </div>

  </div>

  <div class="card shadow-sm">
    <div class="card-body">

      <h2 class="h4 mb-3">Team Roster</h2>

      <% if (players.length === 0) { %>

        <div class="alert alert-info mb-0">
          No players have been added to this team.
        </div>

      <% } else { %>

        <div class="table-responsive">
          <table class="table table-striped align-middle">

            <thead>
              <tr>
                <th>Number</th>
                <th>Player</th>
                <th>Position</th>
                <th>Parent or Guardian</th>
              </tr>
            </thead>

            <tbody>

              <% players.forEach(player => { %>

                <tr>
                  <td>
                    <%= player.jerseyNumber ?? "—" %>
                  </td>

                  <td>
                    <%= player.firstName %>
                    <%= player.lastName %>
                  </td>

                  <td>
                    <%= player.position || "—" %>
                  </td>

                  <td>
                    <%= player.parentName || "—" %>
                  </td>
                </tr>

              <% }) %>

            </tbody>

          </table>
        </div>

      <% } %>

    </div>
  </div>

</main>

</body>
</html>
