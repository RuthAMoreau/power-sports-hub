<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Teams | Power Sports Hub</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container">

    <a class="navbar-brand" href="/">
      Power Sports Hub
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav ms-auto">

        <li class="nav-item">
          <a class="nav-link" href="/dashboard">
            Dashboard
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link active" href="/teams">
            Teams
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/players">
            Players
          </a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="/logout">
            Logout
          </a>
        </li>

      </ul>
    </div>

  </div>
</nav>

<main class="container py-5">

  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"
  >
    <div>
      <h1 class="mb-1">Teams</h1>

      <p class="text-muted mb-0">
        View and manage teams in the organization.
      </p>
    </div>

    <a href="/teams/new" class="btn btn-primary">
      Add Team
    </a>
  </div>

  <% if (teams.length === 0) { %>

    <div class="alert alert-info">
      No teams have been created yet.

      <a href="/teams/new" class="alert-link">
        Create the first team.
      </a>
    </div>

  <% } else { %>

    <div class="row g-4">

      <% teams.forEach(team => { %>

        <div class="col-12 col-md-6 col-lg-4">

          <div class="card h-100 shadow-sm">

            <div class="card-body d-flex flex-column">

              <h2 class="h4 card-title">
                <%= team.teamName %>
              </h2>

              <p class="mb-2">
                <strong>Age Group:</strong>
                <%= team.ageGroup %>
              </p>

              <p class="mb-2">
                <strong>Season:</strong>
                <%= team.season %>
              </p>

              <p class="mb-3">
                <strong>Coach:</strong>

                <% if (team.coach) { %>
                  <%= team.coach.firstName %>
                  <%= team.coach.lastName %>
                <% } else { %>
                  Not assigned
                <% } %>
              </p>

              <div class="mt-auto">
                <a
                  href="/teams/<%= team._id %>"
                  class="btn btn-outline-primary"
                >
                  View Roster
                </a>

                <a
                  href="/players/new?team=<%= team._id %>"
                  class="btn btn-primary"
                >
                  Add Player
                </a>
              </div>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  <% } %>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
